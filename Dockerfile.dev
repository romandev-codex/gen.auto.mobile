# Development image for the Next.js app. The source is bind-mounted at /app by
# docker-compose.yml (profile "full"), so this image only provides Node; the
# dependencies live in a named volume and are installed on start.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
# Reinstall only when package-lock.json changed since the last install, so a
# restart is fast and a dependency bump needs no image rebuild.
CMD ["sh", "-c", "\
  if ! cmp -s package-lock.json node_modules/.lock-snapshot 2>/dev/null; then \
    npm ci && cp package-lock.json node_modules/.lock-snapshot; \
  fi && \
  exec npm run dev -- --hostname 0.0.0.0 --port 3000"]
